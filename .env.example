# Copy to .env and fill in. NEVER commit a real .env.

# --- PostgreSQL (docker-compose + app) ---
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=change-me-use-a-secret-manager
POSTGRES_DB=rag_state
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://rag_user:change-me-use-a-secret-manager@localhost:5433/rag_state

# --- StatefulRAG runtime config ---
# Match your embedding model's output dimension (OpenAI=1536, MiniLM=384, ...).
STATEFUL_RAG_EMBED_DIM=1536
STATEFUL_RAG_EMBED_MODEL=text-embedding-3-small

# Generate with: python -c "from stateful_rag import ContentCipher; print(ContentCipher.generate_key())"
STATEFUL_RAG_ENCRYPTION_KEY=

# Salt for hashing queries in the audit log (set to a per-deployment secret).
STATEFUL_RAG_AUDIT_SALT=change-me

# Safety: strict | balanced | fast  (strict recommended for clinical use)
STATEFUL_RAG_SAFETY_MODE=strict
STATEFUL_RAG_DRIFT_THRESHOLD=0.85
STATEFUL_RAG_PER_DOC_FLOOR=0.5
STATEFUL_RAG_MAX_DIVERGENCE=0.5
STATEFUL_RAG_CACHE_TTL=86400

# Logging
STATEFUL_RAG_LOG_LEVEL=INFO
STATEFUL_RAG_LOG_FORMAT=json

# ============================================================
# ENT AI-Receptionist backend (app/)
# ============================================================
RAG_CORPUS_DIR=/Users/naveen/Downloads/RAG DB
RAG_DATA_DIR=data
RAG_INDEX_PATH=data/ent_index.npz

# Embeddings: hashing (offline) | gemini | sentence_transformers | openai
# Production (Google AI Studio): gemini-embedding-001 at 768-dim.
RAG_EMBED_PROVIDER=gemini
RAG_EMBED_MODEL=gemini-embedding-001
RAG_EMBED_DIM=768

# Google AI Studio key (used by both gemini embeddings and the Gemini LLM).
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Vector store: file (offline) | pgvector
RAG_MAIN_STORE=file
RAG_MAIN_TOP_K=5

# Chunking
RAG_CHUNK_CHARS=1200
RAG_CHUNK_OVERLAP=200

# Dialogue: rule_based (offline) | gemini | openai | anthropic
# NOTE: there is no "gemini 3.5 flash"; use a real Flash id.
RAG_LLM_PROVIDER=gemini
RAG_LLM_MODEL=gemini-2.5-flash
RAG_MAX_TURNS=8

# StatefulRAG drift thresholds — CALIBRATED for gemini-embedding-001 on the ENT
# corpus (app.eval). On/cross-topic separation is small (~0.03) in this domain,
# so keep SafetyMode STRICT (verify every cache hit). Re-run app.eval if you
# change the embedding model.
RAG_DRIFT_THRESHOLD=0.78
RAG_PER_DOC_FLOOR=0.476

# Cache backend for the StatefulRAG layer: memory | pgvector
RAG_CACHE_STORE=memory
